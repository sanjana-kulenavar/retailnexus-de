# Copy this file to .env and fill in your own values.
# Never commit .env or real credentials.

# ── Kafka ──────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_POS=pos-transactions

# ── AWS ────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_DEFAULT_REGION=eu-west-1
S3_BUCKET_BRONZE=retailnexus-bronze-dev
S3_BUCKET_SILVER=retailnexus-silver-dev

# ── Snowflake ──────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account_here
SNOWFLAKE_USER=your_user_here
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_WAREHOUSE=RETAILNEXUS_WH
SNOWFLAKE_DATABASE=RETAILNEXUS_PROD
SNOWFLAKE_SCHEMA=MARTS
SNOWFLAKE_ROLE=DBT_ROLE

# ── Airflow ─────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
