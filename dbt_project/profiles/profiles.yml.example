# Copy this file to dbt_project/profiles/profiles.yml and fill in the
# values through environment variables (see .env.example).
# profiles.yml is gitignored and is not committed.

retailnexus_dbt:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'DBT_ROLE') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'RETAILNEXUS_PROD') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'RETAILNEXUS_WH') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA', 'MARTS') }}"
      threads: 4
      client_session_keep_alive: false
